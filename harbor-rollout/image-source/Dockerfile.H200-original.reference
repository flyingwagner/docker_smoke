# Multi-stage build: fetch pinned codex binaries from npm, ship on a slim glibc base.
FROM node:22-slim AS fetch
ARG CODEX_VERSION=0.158.0
RUN npm install -g @openai/codex@${CODEX_VERSION} && \
    BIN_DIR=$(dirname "$(find /usr/local/lib/node_modules -type f -name codex -size +10M | head -1)") && \
    mkdir -p /out && \
    cp -a "${BIN_DIR}/." /out/ && \
    ls -la /out

FROM debian:bookworm-slim
ARG CODEX_VERSION=0.158.0
LABEL org.opencontainers.image.title="qrepair-agent" \
      org.opencontainers.image.description="Isolated codex agent runtime for the qrepair pipeline" \
      org.opencontainers.image.version="${CODEX_VERSION}"
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates curl git ripgrep jq bubblewrap python3 python3-pip python3-venv && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --create-home --shell /bin/bash agent
COPY --from=fetch /out/ /usr/local/bin/
COPY codex-config.toml /home/agent/.codex/config.toml
RUN chmod 0755 /usr/local/bin/codex /usr/local/bin/codex-code-mode-host && \
    /usr/local/bin/codex --version && \
    chown -R agent:agent /home/agent/.codex
USER agent
WORKDIR /workspace
ENTRYPOINT ["codex"]
